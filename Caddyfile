# MENTORS dev-stand reverse proxy (spec 3/18).
# Automatic TLS: Caddy tries Let's Encrypt first, then ZeroSSL as a fallback
# (both ACME CAs are attempted by default). SITE_ADDRESS is injected from the
# environment (docker-compose caddy service) — currently the temporary sslip.io
# name; moving to a permanent domain = change SITE_ADDRESS + PLATFORM_URL + A record.
{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy web:3000

	# Access-log (заход B.2, хвост 4.2). Файл лежит на ИМЕНОВАННОМ ТОМЕ
	# (caddy_logs), а не в слое контейнера: пересоздание контейнера при деплое
	# не должно уносить историю запросов. Ротация — средствами самого Caddy,
	# внешний logrotate не нужен.
	#
	# Приватность: логи локальные, наружу не уходят (принцип 0.7 «никакой
	# телеметрии наружу»), срок жизни ограничен ротацией — 14 дней (336h).
	# Заголовки Cookie и Authorization УДАЛЯЮТСЯ явным фильтром, а не «по
	# умолчанию»: сессионный токен в логе — это лежащий на диске ключ от
	# аккаунта (spec 11: в БД и логах только хеши). Set-Cookie в ответе — то же
	# самое, поэтому режется вместе с ними.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 336h
		}
		# json даёт всё требуемое: ts, request>method, request>uri, status,
		# duration, size, request>remote_ip, request>headers>User-Agent.
		#
		# СТРОКА ЗАПРОСА НЕ ПИШЕТСЯ (решение владельца, заход B.2): у ученических
		# GET-роутов она содержательна — `/questions?q=…` это поисковый запрос по
		# банку, то есть перечень пробелов конкретного человека. Режется у пути И
		# у Referer: иначе тот же запрос приезжал бы в лог со следующей страницы.
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*" ""
				request>headers>Referer regexp "\?.*" ""
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

# Transitional 301 from the previous sslip.io name during the IP migration
# (ТСПУ-фильтрация старого адреса — см. changelog ТЗ). SITE_ADDRESS_OLD is injected
# from .env.prod / compose. Remove this block once the old IP is detached in the
# Beget panel and the old name is retired.
{$SITE_ADDRESS_OLD} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
