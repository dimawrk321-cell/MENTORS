# dependencies
/node_modules

# next.js
/.next
/out
next-env.d.ts

# production
/build

# env — секреты только в env, не в репозитории
.env
.env.local
.env*.local
# prod secrets live only on the server (dev-stand mini-stage)
.env.prod

# misc
*.tsbuildinfo
coverage
.DS_Store

# claude code local session settings
.claude/settings.local.json

# prisma
/prisma/*.db

# portable postgresql (binaries + data catalog, installed via pnpm db:setup)
/pgsql/

# raw Notion export — importer input (fed via `pnpm import -- --file=…`),
# not source code; kept out of the repo (spec 7.14, importer stage)
/import/

# importer run output — regenerated on every `pnpm import`, not source
/import-report.md

# database dumps / backups — contain real user + content data, never commit
/backups/
# full deploy logs — deploy.sh tees every run into the clone on the server
/deploy-logs/
*.dump

# design handoff — unzipped prototypes + assets (reference only, not app code)
/PRIME - *.dc.html
/support.js
/ios-frame.jsx
/github.md
/design_handoff_mentors/
/fonts/
/uploads/
/Дизайн платформы MENTORS.zip

# app-generated session thumbnail
.thumbnail

# Notion export used by scripts/autolink-questions.ts — source data, not code
notion-export.md

# Notion export / generated review files — source data, not code
suggestions.md
